#!/usr/bin/env bash
# R$F developer bootstrap: Python environment (.venv), the raf CLI, the web workbench build and
# R$F OS (the raf-os terminal panel behind `raf tui`).
#
#   ./scripts/bootstrap            install everything (web build when npm is available, R$F OS when cargo is)
#   ./scripts/bootstrap --no-web   skip the web workbench
#   ./scripts/bootstrap --no-tui   skip R$F OS
#   ./scripts/bootstrap --check    also run lint, type checks and tests
#
# Nothing is installed outside the repository: the Python environment is ./.venv, the web
# dependencies are ./web/node_modules and R$F OS is built into ./tui/target. Uses uv (with
# uv.lock) when available, else python3 + pip.
set -euo pipefail

cd "$(dirname "$0")/.."
WEB=1
TUI=1
CHECK=0
for arg in "$@"; do
  case "$arg" in
    --no-web) WEB=0 ;;
    --no-tui) TUI=0 ;;
    --check) CHECK=1 ;;
    -h|--help) sed -n '2,12p' "$0"; exit 0 ;;
    *) echo "unknown option: $arg" >&2; exit 2 ;;
  esac
done

say() { printf '\033[1m==> %s\033[0m\n' "$*"; }

say "Python environment"
if command -v uv >/dev/null 2>&1; then
  uv sync --frozen
else
  PY="${PYTHON:-python3}"
  if ! "$PY" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 12) else 1)'; then
    echo "R\$F needs Python 3.12 or newer (found: $("$PY" --version 2>&1)). Set PYTHON=/path/to/python3.12." >&2
    exit 1
  fi
  [ -d .venv ] || "$PY" -m venv .venv
  .venv/bin/python -m pip install --quiet --upgrade pip
  .venv/bin/python -m pip install --quiet -e . --group dev
fi
.venv/bin/raf --version

if [ "$WEB" = 1 ]; then
  if command -v npm >/dev/null 2>&1; then
    say "Web workbench (web/)"
    (cd web && npm ci --no-audit --no-fund && npm run build)
  else
    echo "npm not found: skipping the web workbench (the CLI and API work without it)."
  fi
fi

if [ "$TUI" = 1 ]; then
  if command -v cargo >/dev/null 2>&1; then
    say "R\$F OS terminal panel (tui/)"
    cargo build --release --locked --manifest-path tui/Cargo.toml
  else
    echo "cargo not found: skipping R\$F OS (raf tui). Install Rust (https://rustup.rs), then run this again."
  fi
fi

if [ "$CHECK" = 1 ]; then
  say "Checks"
  .venv/bin/ruff check src tests scripts
  .venv/bin/ruff format --check src tests scripts
  .venv/bin/mypy
  .venv/bin/pytest -q
  if [ "$TUI" = 1 ] && command -v cargo >/dev/null 2>&1; then
    cargo fmt --manifest-path tui/Cargo.toml --check
    cargo clippy --manifest-path tui/Cargo.toml --all-targets --locked -- -D warnings
    cargo test --manifest-path tui/Cargo.toml --locked
  fi
fi

say "Ready"
cat <<'EOF'
  source .venv/bin/activate
  raf demo load            # fictional Raven Industries dataset (incident INC-001)
  raf graph alice
  raf replay INC-001
  raf tui                  # R$F OS: the full-screen terminal control panel
  raf serve                # API + web workbench on http://127.0.0.1:8765
EOF
