#!/usr/bin/env bash
# Build the R$F wheel with the web workbench and check it in a clean environment: install it into a
# new virtualenv, load the demo into a temporary R$F home, start `raf serve` on 127.0.0.1 and check
# that it serves the packaged workbench and the API - no source checkout, no Node.js involved.
#
#   ./scripts/check-wheel              needs web/dist (cd web && npm ci && npm run build) and uv
#   ./scripts/check-wheel --keep       keep the temporary directory (wheel, venv, home, server log)
#
# The wheel is left in dist/.
set -euo pipefail

cd "$(dirname "$0")/.."
KEEP=0
for arg in "$@"; do
  case "$arg" in
    --keep) KEEP=1 ;;
    -h|--help) sed -n '2,9p' "$0"; exit 0 ;;
    *) echo "unknown option: $arg" >&2; exit 2 ;;
  esac
done
if [ ! -f web/dist/index.html ]; then
  echo "web/dist is missing: build the workbench first (cd web && npm ci && npm run build)." >&2
  exit 1
fi
command -v uv >/dev/null 2>&1 || { echo "check-wheel needs uv (https://docs.astral.sh/uv/)." >&2; exit 1; }

say() { printf '\033[1m==> %s\033[0m\n' "$*"; }
TMP=$(mktemp -d)
SERVER=""
cleanup() {
  if [ -n "$SERVER" ] && kill -0 "$SERVER" 2>/dev/null; then
    kill "$SERVER" 2>/dev/null || true
    for _ in $(seq 1 50); do kill -0 "$SERVER" 2>/dev/null || break; sleep 0.2; done
    kill -9 "$SERVER" 2>/dev/null || true
  fi
  if [ "$KEEP" = 1 ]; then echo "kept: $TMP"; else rm -rf "$TMP"; fi
}
trap cleanup EXIT

say "Wheel"
RAF_REQUIRE_WEB_DIST=1 uv build --wheel --out-dir dist >/dev/null
WHEEL=$(ls -t dist/raf-*.whl | head -1)
echo "$WHEEL"

say "Clean environment"
uv venv --quiet --python 3.12 "$TMP/venv"
uv pip install --quiet --python "$TMP/venv/bin/python" "$WHEEL"
RAF="$TMP/venv/bin/raf"
export RAF_HOME="$TMP/home"
unset RAF_WORKSPACE RAF_STORAGE_URL
cd "$TMP"  # nothing from the checkout is reachable from here
"$RAF" --version
"$RAF" --quiet --yes demo load >/dev/null

say "raf serve"
PORT=$("$TMP/venv/bin/python" -c 'import socket; s = socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1])')
"$RAF" serve --host 127.0.0.1 --port "$PORT" >"$TMP/serve.log" 2>&1 &
SERVER=$!
URL="http://127.0.0.1:$PORT"
for _ in $(seq 1 150); do
  curl -fsS "$URL/api/v1/health" >/dev/null 2>&1 && break
  kill -0 "$SERVER" 2>/dev/null || { cat "$TMP/serve.log" >&2; exit 1; }
  sleep 0.2
done
curl -fsS "$URL/api/v1/health"
echo
curl -fsS "$URL/" -o "$TMP/index.html"
cmp -s "$TMP/index.html" "$OLDPWD/web/dist/index.html" || { echo "raf serve does not serve the packaged workbench" >&2; exit 1; }
curl -fsS "$URL/timeline" -o /dev/null  # a client-side route gets the workbench too
curl -fsS "$URL/api/v1/status" | "$TMP/venv/bin/python" -c 'import json, sys; d = json.load(sys.stdin)["data"]; assert d["objects"] > 0 and d["events"] > 0, d; print("status: objects", d["objects"], "events", d["events"])'
echo "OK: the wheel serves the workbench and the API from a clean environment"
